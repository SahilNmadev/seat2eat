# Settings for the Set2eat server. Change the two values below, save the file, then restart the server.
# Lines starting with # are notes and are ignored.

# Password of the first counter account. Username: admin
# (only used the very first time the server starts and creates counter.db)
ADMIN_PASSWORD=ChangeThisPassword1

# Secret staff code. Counter staff need this code to Sign up on the counter login page.
# Share it only with your staff. If you leave it empty, counter Sign up is switched off.
ADMIN_SIGNUP_CODE=ChangeThisStaffCode1